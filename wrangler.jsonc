{
  "name": "cdc-habitat-recouvrement",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{
    "pattern": "recouvrement.cdc-habitat.sn",
    "custom_domain": true
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cdc-habitat-recouvrement",
    "database_id": "REMPLACER_PAR_IDENTIFIANT_D1"
  }],
  "vars": {
    "APP_ORIGIN": "https://recouvrement.cdc-habitat.sn",
    "INVITE_FROM": "REMPLACER_PAR_EXPEDITEUR_VERIFIE"
  }
}
